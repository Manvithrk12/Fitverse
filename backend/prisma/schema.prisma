// FITVERSE — Prisma Schema
// Phase 1: User + RefreshToken (authentication). Remaining entities
// (Profile, Workout, Nutrition, Progress, Gamification, Social, AI, etc.)
// are added in later phases per the Database Design & ER Diagram Spec.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  profile       Profile?
  workouts      Workout[]
}

// Refresh tokens are stored hashed (never the raw token) so a logout or
// rotation can actually revoke server-side, rather than just trusting the
// client to discard it.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum FitnessGoal {
  MUSCLE_GAIN
  FAT_LOSS
  WEIGHT_MAINTENANCE
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTREMELY_ACTIVE
}

enum DietaryPreference {
  NONE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETO
  PALEO
  GLUTEN_FREE
  HALAL
  KOSHER
}

enum WorkoutType {
  STRENGTH_TRAINING
  CARDIO
  HIIT
  YOGA
  PILATES
  CROSSFIT
  CALISTHENICS
  MIXED
}

// 1:1 with User. All fitness fields are nullable — profile setup is
// progressive, and PUT /profiles/me does a true full-replace upsert (a
// field omitted from the request clears to null), so partial-vs-complete
// is entirely a frontend concern, not a backend one.
model Profile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                  Int?
  heightCm             Float?
  weightKg             Float?
  targetWeightKg       Float?
  fitnessGoal          FitnessGoal?
  activityLevel        ActivityLevel?
  workoutFrequency     Int?
  availableEquipment   String[]           @default([])
  dietaryPreference    DietaryPreference?
  preferredWorkoutType WorkoutType?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
}

// Reuses WorkoutType from the Fitness Profile taxonomy (Step 1) rather than
// defining a second one, per the requirement to align the two. workoutType
// is nullable — a workout doesn't strictly need a category to be useful.
// status only ever moves PLANNED -> COMPLETED via PATCH /:id/complete;
// title/description/scheduledDate/durationMinutes/workoutType are edited
// via PUT — keeping "mark complete" as the single path that can set
// COMPLETED avoids two different endpoints being able to race on the same
// transition.
model Workout {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  workoutType     WorkoutType?
  description     String?
  scheduledDate   DateTime?
  durationMinutes Int?
  status          WorkoutStatus @default(PLANNED)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([userId, scheduledDate])
}
