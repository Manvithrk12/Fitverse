# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (matches docker-compose.yml postgres service)
DATABASE_URL="postgresql://fitverse:fitverse@localhost:5432/fitverse?schema=public"

# Auth (Phase 1)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required — the server will not start without this set.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque, DB-validated tokens (not JWTs), so they don't
# need their own signing secret — this only controls their lifetime.
JWT_REFRESH_EXPIRES_IN_DAYS=7

# AI (added in Phase 12)
AI_API_KEY=

# AWS (added in Phase 13 / Phase 16)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
